{
  "name": "@incidenthub/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Shared types and enums for IncidentHub AI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
