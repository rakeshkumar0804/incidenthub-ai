/// Trigger source for AI Postmortem generation.
enum PostmortemTriggerType {
  AUTOMATIC_INCIDENT_RESOLVED
  MANUAL_REQUEST
  REGENERATE_REQUEST
}

/// Audit log for an AI Postmortem generation execution run.
model PostmortemRun {
  id               String                 @id @default(cuid())
  organizationId   String
  incidentId       String
  postmortemId     String?
  triggerType      PostmortemTriggerType  @default(MANUAL_REQUEST)
  status           InvestigationStatus    @default(RUNNING)
  providerName     String                 @default("openai")
  modelName        String                 @default("gpt-4o")
  promptTokens     Int                    @default(0)
  completionTokens Int                    @default(0)
  totalTokens      Int                    @default(0)
  latencyMs        Int                    @default(0)
  error            String?                @db.Text
  triggeredById    String?
  startedAt        DateTime               @default(now())
  completedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  triggeredBy  User?        @relation("TriggeredPostmortemRuns", fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([incidentId, startedAt(sort: Desc)])
  @@index([status])
  @@map("postmortem_runs")
}

// =============================================================================
// Phase 12 — Analytics + Engineering Intelligence Models
// =============================================================================

/// Derived, rebuildable analytics snapshot for organization dashboard views.
model AnalyticsSnapshot {
  id              String   @id @default(cuid())
  organizationId  String
  timeWindow      String   // "24h", "7d", "30d", "90d", "custom"
  periodStart     DateTime
  periodEnd       DateTime
  totalIncidents  Int      @default(0)
  sev1Count       Int      @default(0)
  sev2Count       Int      @default(0)
  sev3Count       Int      @default(0)
  sev4Count       Int      @default(0)
  mttdMs          Float?
  mttrMs          Float?
  cfrPercent      Float?
  metricsJson     Json     // Time-series buckets & detailed metrics
  calculatedAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, timeWindow, periodStart, periodEnd])
  @@index([organizationId])
  @@map("analytics_snapshots")
}

/// Derived, rebuildable service-level reliability metrics.
model ServiceReliabilityMetric {
  id              String   @id @default(cuid())
  organizationId  String
  serviceId       String
  timeWindow      String   // "24h", "7d", "30d", "90d", "custom"
  periodStart     DateTime
  periodEnd       DateTime
  totalIncidents  Int      @default(0)
  sev1Count       Int      @default(0)
  mttrMs          Float?
  mttdMs          Float?
  cfrPercent      Float?
  calculatedAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, serviceId, timeWindow, periodStart, periodEnd])
  @@index([organizationId])
  @@index([serviceId])
  @@map("service_reliability_metrics")
}

// =============================================================================
// Phase 13 — Slack + Jira Integrations Models
// =============================================================================

/// Status lifecycle for asynchronous integration delivery attempts.
enum IntegrationDeliveryStatus {
  PENDING
  PROCESSING
  RETRYING
  SUCCESS
  FAILED
  CANCELLED
}

/// Universal cross-system reference mapping IncidentHub entities to external provider resources.
model ExternalReference {
  id                   String              @id @default(cuid())
  organizationId       String
  integrationId        String
  provider             IntegrationProvider
  entityType           String              // "INCIDENT", "ACTION_ITEM", "POSTMORTEM", "SERVICE"
  entityId             String              // Local IncidentHub record ID
  externalResourceType String              // "SLACK_CHANNEL", "SLACK_MESSAGE", "JIRA_ISSUE"
  externalId           String              // Slack channel ID, Slack message TS, Jira issue key/ID
  externalUrl          String?             // Direct web URL
  metadata             Json?               // Provider-specific metadata (sync correlation IDs, titles)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, entityType, entityId, externalResourceType, externalId])
  @@index([organizationId])
  @@index([provider, externalId])
  @@map("external_references")
}

/// Audit log and retry queue for outbound external delivery attempts (Slack messages, Jira API calls).
model IntegrationDelivery {
  id             String                    @id @default(cuid())
  organizationId String
  integrationId  String
  provider       IntegrationProvider
  eventType      String                    // "slack.notification", "slack.channel_create", "jira.issue_create"
  sanitizedBody  Json                      // Sanitized request metadata (secrets/tokens stripped)
  status         IntegrationDeliveryStatus @default(PENDING)
  attemptCount   Int                       @default(0)
  lastError      String?                   @db.Text
  nextRetryAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status, nextRetryAt])
  @@map("integration_deliveries")
}
