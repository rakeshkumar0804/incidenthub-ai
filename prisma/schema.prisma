model SentryIssue {
  id             String    @id @default(cuid())
  organizationId String
  integrationId  String
  sentryIssueId  String
  projectSlug    String
  title          String
  culprit        String?
  level          String    @default("error")
  userCount      Int       @default(1)
  eventCount     Int       @default(1)
  firstSeen      DateTime  @default(now())
  lastSeen       DateTime  @default(now())
  release        String?
  environment    String    @default("production")
  permalink      String?
  stackTrace     String?   @db.Text

  projectId      String?
  serviceId      String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, sentryIssueId])
  @@index([organizationId])
  @@index([projectId])
  @@index([serviceId])
  @@index([environment])
  @@index([level])
  @@map("sentry_issues")
}

model SentryRule {
  id                 String           @id @default(cuid())
  organizationId     String
  name               String
  environment        String?
  minEventCount      Int              @default(10)
  minUserCount       Int              @default(5)
  levelFilter        String?
  mappedSeverity     IncidentSeverity @default(SEV2)
  autoCreateIncident Boolean          @default(false)

  projectId          String?
  serviceId          String?

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@index([serviceId])
  @@map("sentry_rules")
}

// =============================================================================
// PHASE 9 ENUMS & AI INVESTIGATION MODELS
// =============================================================================

/// Status of an AI Investigation Engine execution run.
enum InvestigationStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// Confidence tier derived from AI investigation analysis.
enum InvestigationConfidenceTier {
  HIGH
  MEDIUM
  LOW
  UNCERTAIN
}

/// Trigger source for an AI Investigation execution.
enum InvestigationTriggerType {
  AUTOMATIC_CORRELATION_COMPLETED
  MANUAL_REQUEST
  RERUN_REQUEST
}

/// Tracks an execution session of the AI Investigation Engine for auditability, telemetry, and evidence-grounded root cause analysis.
model InvestigationRun {
  id                       String                       @id @default(cuid())
  organizationId           String
  incidentId               String
  correlationRunId         String?
  status                   InvestigationStatus          @default(RUNNING)
  triggerType              InvestigationTriggerType     @default(MANUAL_REQUEST)
  confidenceTier           InvestigationConfidenceTier?
  confidence               Float?

  incidentSummary          String?                      @db.Text
  probableRootCause        String?                      @db.Text
  supportingEvidence       Json?
  contradictoryEvidence    Json?
  alternativeHypotheses    Json?
  impactAssessment         String?                      @db.Text
  riskAssessment           String?                      @db.Text
  recommendedActions       Json?
  uncertainty              Json?
  investigationLimitations String?                      @db.Text

  providerName             String                       @default("openai")
  modelName                String                       @default("gpt-4o")
  promptTokens             Int                          @default(0)
  completionTokens         Int                          @default(0)
  totalTokens              Int                          @default(0)
  latencyMs                Int                          @default(0)
  validationError          String?                      @db.Text

  triggeredById            String?
  startedAt                DateTime                     @default(now())
  completedAt              DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident       Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  correlationRun CorrelationRun? @relation(fields: [correlationRunId], references: [id], onDelete: SetNull)
  triggeredBy    User?           @relation("TriggeredInvestigationRuns", fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([incidentId, startedAt(sort: Desc)])
  @@index([status])
  @@map("investigation_runs")
}

// =============================================================================
// Phase 10 — Incident Replay Engine
// =============================================================================

/// Execution status of an Incident Replay run.
enum ReplayRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// Trigger source for Incident Replay execution.
enum ReplayTriggerType {
  AUTOMATIC_INCIDENT_RESOLVED
  MANUAL_REQUEST
  RERUN_REQUEST
}

/// Categorizes events for UI filtering and deterministic tie-breaking.
enum ReplayCategory {
  STATE_CHANGE   // System & Human incident state modifications (Weight 10)
  TELEMETRY      // GitHub activity & Sentry error signals (Weight 20)
  CORRELATION    // Phase 8 correlation execution milestones (Weight 30)
  INVESTIGATION  // Phase 9 AI investigation lifecycle milestones (Weight 30)
  COMMUNICATION  // Team discussion comments and replies (Weight 40)
}

/// Tracks an Incident Replay execution run.
model ReplayRun {
  id              String            @id @default(cuid())
  organizationId  String
  incidentId      String
  triggerType     ReplayTriggerType @default(MANUAL_REQUEST)
  status          ReplayRunStatus   @default(RUNNING)
  windowStart     DateTime
  windowEnd       DateTime
  totalEventCount Int               @default(0)
  isTruncated     Boolean           @default(false)
  error           String?           @db.Text
  triggeredById   String?
  startedAt       DateTime          @default(now())
  completedAt     DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  triggeredBy  User?         @relation("TriggeredReplayRuns", fields: [triggeredById], references: [id], onDelete: SetNull)
  events       ReplayEvent[]

  @@index([organizationId])
  @@index([incidentId, startedAt(sort: Desc)])
  @@index([status])
  @@map("replay_runs")
}

/// A single normalized, chronologically ordered event in an Incident Replay run.
model ReplayEvent {
  id             String         @id @default(cuid())
  replayRunId    String
  incidentId     String
  organizationId String
  sequenceIndex  Int            // 1-indexed deterministic sequence position
  category       ReplayCategory
  categoryWeight Int            @default(10) // Tie-breaker weight for identical timestamps
  eventType      String
  source         EventSource    @default(SYSTEM)
  sourceEventId  String         // Deterministic composite ID: sourceTable:sourceId:eventType:subIndex
  timestamp      DateTime
  actorName      String?
  actorEmail     String?
  title          String
  description    String?        @db.Text
  externalUrl    String?
  evidenceId     String?
  metadata       Json?

  replayRun ReplayRun @relation(fields: [replayRunId], references: [id], onDelete: Cascade)

  @@unique([replayRunId, sequenceIndex])
  @@unique([replayRunId, sourceEventId])
  @@index([incidentId, timestamp])
  @@index([organizationId])
  @@map("replay_events")
}

// =============================================================================
// Phase 11 — AI Postmortem Engine Audit Models
